{
  "version": 1,
  "title": "Create a project in Littleboard",
  "url": "http://127.0.0.1:4310/sample",
  "viewport": {
    "width": 1280,
    "height": 800
  },
  "template": "studio",
  "trimWaiting": true,
  "timeoutMs": 15000,
  "steps": [
    {
      "id": "create",
      "action": "click",
      "target": "role:button:New project",
      "value": "",
      "caption": "Open the new project form.",
      "waitFor": "#dialog",
      "holdMs": 2200,
      "zoom": 1.35,
      "trimStart": 0,
      "trimEnd": 0
    },
    {
      "id": "name",
      "action": "fill",
      "target": "label:Project name",
      "value": "Launch a little sooner",
      "caption": "Enter a project name.",
      "waitFor": "",
      "holdMs": 1600,
      "zoom": 1.3,
      "trimStart": 0,
      "trimEnd": 0
    },
    {
      "id": "save",
      "action": "click",
      "target": "role:button:Create project",
      "value": "",
      "caption": "Create the project and find it on the board.",
      "waitFor": "text:Launch a little sooner",
      "holdMs": 2800,
      "zoom": 1.35,
      "trimStart": 0,
      "trimEnd": 0
    }
  ]
}
